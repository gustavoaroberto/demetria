{
  "name": "demetria",
  "version": "0.1.1",
  "description": "Schema-driven multi-step HTML forms for any JavaScript application.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint src test e2e scripts examples website/assets eslint.config.js vitest.config.ts playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "verify:consumer": "npm run build && tsc -p tsconfig.consumer.json",
    "package:check": "npm pack --dry-run --ignore-scripts",
    "docs:build": "npm run build && node scripts/build-docs.mjs",
    "docs:check": "npm run docs:build && node scripts/check-docs.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "release:check": "npm run format:check && npm run check && npm run docs:check && npm run test:a11y && tsc -p tsconfig.consumer.json && npm run package:check",
    "prepack": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavoaroberto/demetria.git"
  },
  "keywords": [
    "forms",
    "form-validation",
    "multi-step-form",
    "schema-driven",
    "typescript",
    "vanilla-javascript",
    "wizard"
  ],
  "author": "Gustavo A. Roberto",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gustavoaroberto/demetria/issues"
  },
  "homepage": "https://github.com/gustavoaroberto/demetria#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
